{
  "mcpServers": {
    "linkedin": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@4.24.0",
        "--transport",
        "stdio",
        "--timeout",
        "10000",
        "--tool-timeout",
        "180"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}
