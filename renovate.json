{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "group:allNonMajor"],
  "schedule": ["before 6am on Monday"],
  "pre-commit": {
    "enabled": true
  },
  "pip-compile": {
    "managerFilePatterns": ["/^build-constraints\\.txt$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "MCPB CLI pinned in the release workflow",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["MCPB_VERSION:\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "@anthropic-ai/mcpb",
      "datasourceTemplate": "npm"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Managed by release workflow, not Renovate",
      "matchPackageNames": ["stickerdaniel/linkedin-mcp-server"],
      "matchManagers": ["docker-compose"],
      "enabled": false
    },
    {
      "description": "Group all CI dependencies (GitHub Actions + Docker)",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "matchPackageNames": ["!stickerdaniel/linkedin-mcp-server"],
      "groupName": "CI dependencies"
    },
    {
      "description": "Group all major updates together",
      "matchUpdateTypes": ["major"],
      "groupName": "all major dependencies"
    },
    {
      "description": "Group MCP ecosystem packages",
      "matchPackageNames": ["fastmcp", "mcp", "httpx2"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "MCP ecosystem"
    },
    {
      "description": "MCP ecosystem majors move together and apart from other majors: the daemon's owner hop depends on all three at once",
      "matchPackageNames": ["fastmcp", "mcp", "httpx2"],
      "matchUpdateTypes": ["major"],
      "groupName": "MCP ecosystem majors"
    },
    {
      "description": "Python runtime upgrades need manual validation",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "requires-python: bump upper bound to next major.minor only",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "rangeStrategy": "widen",
      "extractVersion": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "description": "Ruff is pinned in pyproject.toml and .pre-commit-config.yaml; tests/test_ruff_toolchain.py requires both to match",
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "groupName": "ruff"
    },
    {
      "description": "Agent guardrails: minor and patch automerge",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["stickerdaniel/agent-guardrails"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "agent-guardrails",
      "groupSlug": "agent-guardrails",
      "automerge": true
    },
    {
      "description": "Agent guardrails: major and digest updates stay manual",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["stickerdaniel/agent-guardrails"],
      "matchUpdateTypes": ["major", "digest", "pin", "pinDigest"],
      "groupName": "agent-guardrails manual",
      "groupSlug": "agent-guardrails-manual",
      "automerge": false
    }
  ]
}
